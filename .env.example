# Port for server to listen on (AI Studio requires 3000)
PORT=3000

# Directory for storing local fallback database file
DATA_DIR=data

# MongoDB Atlas connection string (Free M0 Cluster)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/fakefriendstest?retryWrites=true&w=majority
MONGODB_URI=
